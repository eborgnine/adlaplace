# CppAD via LinkingTo: RCppAD; registration helpers from adlaplace headers
# (no link to adlaplace.so). Eigen from LinkingTo: RcppEigen.
PKG_CPPFLAGS = -DEIGEN_DONT_PARALLELIZE
# Keep CppAD thread_alloc / AD statics local to this DSO (macOS mixed-DSO parallel).
# VISIBILITY_CXXFLAGS set by configure after probing.
PKG_CXXFLAGS = @VISIBILITY_CXXFLAGS@ @WARN_CXXFLAGS@
OBJECTS = RcppExports.o backend.o ad_pack_random_fem.o

all: $(SHLIB) strippedLib

strippedLib: $(SHLIB)
	if command -v strip >/dev/null 2>&1; then case "$$(uname -s)" in Linux) strip --strip-debug "$(SHLIB)";; esac; fi

.PHONY: strippedLib
