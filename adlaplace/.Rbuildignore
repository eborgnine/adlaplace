^\.DS_Store$
^\.lintr$
^\.gitignore$
^\.cursor
^\.\.Rcheck$
# Do not ignore ^build$: R CMD build writes build/vignette.rds, which CRAN
# incoming checks require when DESCRIPTION has VignetteBuilder.
^config\.
^config\.[0-9]+/
^vignettes/.*_files/
^vignettes/.*\.html$
^vignettes/.*\.knit\.md$
^data-raw$
^Rplots\.pdf$
^.*\.tar\.gz$
^src/Makevars$
^src/Makevars\.win$
^src/.*\.o$
^src/.*\.so$
^src/.*\.dll$
^tests/testthat/_snaps$
