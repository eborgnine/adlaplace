#!/bin/sh
# Remove generated files that should not ship in the source tarball.

rm -f src/Makevars

# Quarto / knitr HTML vignette outputs (recreated by quarto render)
rm -rf vignettes/*_files
rm -f vignettes/*.html
rm -f vignettes/*.knit.md
rm -f vignettes/*.R

# testthat creates tests/testthat/_snaps/ even without snapshot tests; remove
# only when empty (silent — avoids git "Removed empty directory" noise)
_snaps=tests/testthat/_snaps
if [ -d "$_snaps" ] && [ -z "$(ls -A "$_snaps" 2>/dev/null)" ]; then
  rmdir "$_snaps" 2>/dev/null || true
fi
