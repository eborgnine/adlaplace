# Core package: owns OpenMP + CppAD parallel_setup (not -fvisibility=hidden;
# backends hide their local CppAD statics instead).
# macOS OpenMP: dynamic libomp (see inst/scripts/backend-configure.sh).
# Eigen headers come from LinkingTo: RcppEigen (R adds -I automatically).
# -I../src/include must precede CppAD -I so src/include/cppad/** shadows system
# headers (R-safe ErrorHandler + configure-generated cout redirects; see
# src/include/cppad/README.md).
PKG_CPPFLAGS = -I../inst/include -I../src/include @CPPAD_CPPFLAGS@ @CPPAD_INCLUDE_CPPFLAGS@ @OPENMP_CPPFLAGS@ @BREW_CPPFLAGS@ -DEIGEN_DONT_PARALLELIZE
PKG_CXXFLAGS = @OPENMP_CXXFLAGS@ @DEBUG_CXXFLAGS@
PKG_LIBS     = @CPPAD_LIBS@ @OPENMP_LIBS@

all: $(SHLIB) strippedLib

strippedLib: $(SHLIB)
	if command -v strip >/dev/null 2>&1; then case "$$(uname -s)" in Linux) strip --strip-debug "$(SHLIB)";; esac; fi

.PHONY: strippedLib
