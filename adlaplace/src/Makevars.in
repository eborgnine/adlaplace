PKG_CPPFLAGS = -I../inst/include -I../src/include @CPPAD_CPPFLAGS@ @CPPAD_INCLUDE_CPPFLAGS@ @OPENMP_CPPFLAGS@ @BREW_CPPFLAGS@ @EIGEN_SYSTEM_CPPFLAGS@ -DEIGEN_DONT_PARALLELIZE
PKG_CXXFLAGS = @OPENMP_CXXFLAGS@ @DEBUG_CXXFLAGS@
PKG_LIBS     = @CPPAD_LIBS@ @OPENMP_LIBS@
SOURCES = $(wildcard *.cpp)
OBJECTS = $(SOURCES:.cpp=.o)
