# CppAD via LinkingTo: RCppAD; runtime link to adlaplace.so.
# Eigen headers come from LinkingTo: RcppEigen (R adds -I automatically).
PKG_CPPFLAGS = -DEIGEN_DONT_PARALLELIZE
# Keep CppAD thread_alloc / AD statics local to this DSO (macOS mixed-DSO parallel).
# @VISIBILITY_CXXFLAGS@ set by configure after probing -fvisibility=hidden.
PKG_CXXFLAGS = @VISIBILITY_CXXFLAGS@
PKG_LIBS     = @ADLAPLACE_LIBS@
OBJECTS = RcppExports.o backend.o adfun_random_fem.o

all: $(SHLIB) strippedLib

strippedLib: $(SHLIB)
	if command -v strip >/dev/null 2>&1; then case "$$(uname -s)" in Linux) strip --strip-debug "$(SHLIB)";; esac; fi

.PHONY: strippedLib
