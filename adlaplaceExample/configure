#!/bin/sh
# configure: backend extension package (sources adlaplace OpenMP / visibility detection)

set -eu

VERBOSE="${ADLAPLACE_CONFIGURE_VERBOSE:-0}"
msg() {
  if [ "$VERBOSE" = "1" ]; then
    echo "$@"
  fi
  return 0
}

# R CMD check --as-cran sets _R_CHECK_R_ON_PATH_, which puts dummy R/Rscript
# first on PATH (WRE §1.6). Always use ${R_HOME}/bin[/x64]/Rscript.
# configure.win sets R_ARCH_BIN (e.g. /x64).
if [ -z "${R_HOME:-}" ]; then
  R_HOME=`R RHOME`
fi
if [ -n "${R_ARCH_BIN:-}" ]; then
  RSCRIPT="${R_HOME}/bin${R_ARCH_BIN}/Rscript"
else
  RSCRIPT="${R_HOME}/bin/Rscript"
fi

ADLAPLACE_SCRIPT_DIR="$("$RSCRIPT" -e 'cat(system.file("scripts", package="adlaplace"))' 2>/dev/null || true)"
if [ -z "$ADLAPLACE_SCRIPT_DIR" ] || [ ! -f "$ADLAPLACE_SCRIPT_DIR/backend-configure.sh" ]; then
  _cand="$(dirname "$0")/../adlaplace/inst/scripts"
  if [ -f "$_cand/backend-configure.sh" ]; then
    ADLAPLACE_SCRIPT_DIR="$(cd "$_cand" && pwd)"
  else
    ADLAPLACE_SCRIPT_DIR=""
  fi
fi
if [ -z "$ADLAPLACE_SCRIPT_DIR" ] || [ ! -f "$ADLAPLACE_SCRIPT_DIR/backend-configure.sh" ]; then
  echo "configure: ERROR: adlaplace backend-configure.sh not found (install adlaplace first)" >&2
  exit 1
fi
. "$ADLAPLACE_SCRIPT_DIR/backend-configure.sh"

set_adlaplace_libs

infile="src/Makevars.in"
# Unix: src/Makevars; Windows configure.win sets MAKEVARS_OUT=src/Makevars.win
outfile="${MAKEVARS_OUT:-src/Makevars}"

if [ ! -f "$infile" ]; then
  echo "configure: ERROR: $infile not found" >&2
  exit 1
fi

esc_sed () { printf '%s' "$1" | sed 's/[\/&]/\\&/g'; }

sed \
  -e "s/@VISIBILITY_CXXFLAGS@/$(esc_sed "$VISIBILITY_CXXFLAGS")/g" \
  -e "s/@ADLAPLACE_LIBS@/$(esc_sed "$ADLAPLACE_LIBS")/g" \
  -e "s/@WARN_CXXFLAGS@/$(esc_sed "$WARN_CXXFLAGS")/g" \
"$infile" > "$outfile"

chmod 644 "$outfile"
exit 0
