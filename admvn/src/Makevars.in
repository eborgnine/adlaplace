# Standalone package: CppAD via LinkingTo: RCppAD; optional OpenMP.
PKG_CPPFLAGS = @OPENMP_CPPFLAGS@
# Keep CppAD thread_alloc / AD statics local to this DSO when mixed with other
# CppAD packages in one R process.
# @VISIBILITY_CXXFLAGS@ set by configure after probing -fvisibility=hidden.
PKG_CXXFLAGS = @OPENMP_CXXFLAGS@ @VISIBILITY_CXXFLAGS@
PKG_LIBS     = @OPENMP_LIBS@

all: $(SHLIB) strippedLib

strippedLib: $(SHLIB)
	if command -v strip >/dev/null 2>&1; then case "$$(uname -s)" in Linux) strip --strip-debug "$(SHLIB)";; esac; fi

.PHONY: strippedLib
