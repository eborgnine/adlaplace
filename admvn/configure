#!/bin/sh
# configure: standalone package (local copy of adlaplace backend-configure.sh)

set -eu

VERBOSE="${ADLAPLACE_CONFIGURE_VERBOSE:-0}"
msg() {
  if [ "$VERBOSE" = "1" ]; then
    echo "$@"
  fi
  return 0
}

SCRIPT_DIR="$(cd "$(dirname "$0")/inst/scripts" && pwd)"
. "$SCRIPT_DIR/backend-configure.sh"

infile="src/Makevars.in"
# Unix: src/Makevars; Windows configure.win sets MAKEVARS_OUT=src/Makevars.win
outfile="${MAKEVARS_OUT:-src/Makevars}"

if [ ! -f "$infile" ]; then
  echo "configure: ERROR: $infile not found" >&2
  exit 1
fi

esc_sed () { printf '%s' "$1" | sed 's/[\/&]/\\&/g'; }

sed \
  -e "s/@OPENMP_CPPFLAGS@/$(esc_sed "$OPENMP_CPPFLAGS")/g" \
  -e "s/@OPENMP_CXXFLAGS@/$(esc_sed "$OPENMP_CXXFLAGS")/g" \
  -e "s/@OPENMP_LIBS@/$(esc_sed "$OPENMP_LIBS")/g" \
  -e "s/@VISIBILITY_CXXFLAGS@/$(esc_sed "$VISIBILITY_CXXFLAGS")/g" \
  -e "s/@WARN_CXXFLAGS@/$(esc_sed "$WARN_CXXFLAGS")/g" \
"$infile" > "$outfile"

chmod 644 "$outfile"
exit 0
